# Local PostgreSQL bootstrap values (development only)
POSTGRES_PASSWORD=local-admin-only-change-me
POSTGRES_APP_USER=unifrendly_app
POSTGRES_APP_PASSWORD=local-app-only-change-me
POSTGRES_MIGRATOR_USER=unifrendly_migrator
POSTGRES_MIGRATOR_PASSWORD=local-migrator-only-change-me

# API
NODE_ENV=development
PORT=8080
HOST=0.0.0.0
DATABASE_URL=postgresql://unifrendly_app:local-app-only-change-me@localhost:5432/unifrendly
DATABASE_SSL=false
JWT_SECRET=replace-with-at-least-32-random-bytes
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
APP_ORIGIN=unifrendly://
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW=1 minute

# S3-compatible private object storage (required to enable uploads)
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
SIGNED_UPLOAD_TTL_SECONDS=300
MEDIA_DELETE_GRACE_HOURS=24

# Optional notification provider configuration is documented in docs/operations.md
EXPO_ACCESS_TOKEN=
EXPO_PUSH_ENABLED=false
